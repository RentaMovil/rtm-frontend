# URL base de la API mock (web/Front-end/mock-server.cjs, puerto 3100)
#
# Dejala vacia para usar el default por plataforma:
#   iOS simulator / web ....... http://localhost:3100
#   Android emulador .......... http://10.0.2.2:3100
#   dispositivo fisico ........ NO sirve localhost -> pon la IP LAN de tu PC
#
# Ejemplo dispositivo fisico (misma wifi que el telefono):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3100
#
# Para un dispositivo fisico tambien hace falta que el mock server escuche
# en todas las interfaces, no solo en localhost:
#   node mock-server.cjs   # ya usa server.listen(3001) sin host, escucha 0.0.0.0
#
# Y que el firewall de Windows permita el puerto 3001 en redes privadas.
EXPO_PUBLIC_API_URL=

# Mismos valores públicos que web/Front-end/src/shared/services/cloudinaryService.js
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dz6ohgjub
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=dav32erzro
