# URL base del API Gateway (rtm-api-gateway, puerto 8080).
#
# La app no habla con cada microservicio por su cuenta: todo pasa por el
# gateway, que enruta /auth y /users a iam, /vehicles y /branches a
# fleet-maintenance, /reservations a booking-reservation, y /payments y
# /bank-accounts a payment-billing.
#
# Dejala vacia para usar el default por plataforma (src/config/env.ts):
#   iOS simulator / web ....... http://localhost:8080
#   Android emulador .......... http://10.0.2.2:8080
#   dispositivo fisico ........ NO sirve localhost -> pon la IP LAN de tu PC
#
# Ejemplo dispositivo fisico (misma wifi que el telefono):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
#
# Ademas, el gateway tiene que permitir el origen de la app en
# CORS_ALLOWED_ORIGINS (rtm-api-gateway/.env): 8081 = Expo web, 5173 = Vite
# del frontend web.
EXPO_PUBLIC_API_URL=

# Mismos valores públicos que web/Front-end/src/shared/services/cloudinaryService.js
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dz6ohgjub
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=dav32erzro
