# Vite solo lee el .env de la raíz del proyecto (aquí).
# Rutas relativas: el proxy de vite.config.js las reenvía (también funciona por un túnel).
# Sin secretos: estas URLs terminan en el navegador.

# API Gateway (localhost:8080): iam, booking y fleet
VITE_API_URL=/api

# Mock (npm run mock-api, localhost:3100): lo que todavía no tiene servicio real
VITE_MOCK_API_URL=/mock

# Cloudinary: ahi se guardan la foto de perfil y el comprobante de pago.
# El preset es "unsigned", asi que sube el navegador y al backend solo le llega la URL.
VITE_CLOUDINARY_CLOUD_NAME=dz6ohgjub
VITE_CLOUDINARY_UPLOAD_PRESET=dav32erzro
